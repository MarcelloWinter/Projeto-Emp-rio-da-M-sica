# LLM provider: openai | gemini | groq | openrouter | deepseek | mistral | ollama | custom
LLM_PROVIDER=openai
LLM_API_KEY=your-key-here
# Optional (defaults come from the provider preset)
# LLM_MODEL=gpt-4.1-mini
# LLM_BASE_URL=
# LLM_EMBEDDING_MODEL=text-embedding-3-small

# Optional: pin the clock (used for the demo conversations)
# AGENT_NOW=2026-03-23T10:30

# Optional: timezone for displayed times (IANA name, or "local" for this computer). Default: America/Campo_Grande
# DISPLAY_TZ=local
